##
# Brewfile
#
# Purpose:
#   Rebuild and maintain a Mac developer workstation using Homebrew Bundle.
#
# Philosophy:
#   - Keep Homebrew for machine-level tooling and GUI apps.
#   - Keep language/framework dependencies inside projects where possible.
#   - Prefer version managers and project manifests over many global installs.
#   - Keep optional and legacy items commented so they remain visible but harmless.
#
# Structure:
#   1. Preflight / taps
#   2. Core shell, terminal & workstation utilities
#   3. Version control & repository workflow
#   4. Network troubleshooting & diagnostics
#   5. Language runtimes & development foundations
#   6. Azure, Bicep tooling
#   7. AWS
#   8. Terraform, Terragrunt & IaC quality
#   9. Containers, Kubernetes & supply-chain review
#   10. AI-assisted code and repository review
#   11. Developer applications
#   12. JetBrains IDEs
#   13. Database clients & local services
#   14. Browsers
#   15. Communication & collaboration
#   16. Security, identity, sync & productivity apps
#   17. Media & personal apps
#   18. Miscellaneous applications, utilities
#   19. VS Code extensions / DevOps, cloud, containers & IaC
#   20. VS Code extensions / Languages, quality & productivity
#   21. Legacy / disabled backlog
#
# Lifecycle labels:
#   Required to rebuild the dev workstation.
#   [Optional]  Useful or personal, but not required for core dev work.
#   [Legacy]    Kept for old projects or historical reference.
#   [Review]    Possible duplicate, pin, renamed item, or unclear ownership.
#   [Disabled]  Commented out and not currently installed by this Brewfile.
#
# Usage:
#   brew bundle check --file homebrew/Brewfile --verbose
#   brew bundle install --file homebrew/Brewfile
#   brew bundle cleanup --file homebrew/Brewfile --verbose
#   brew bundle cleanup --file homebrew/Brewfile --force
##

###########################################################################
# 1. Preflight / taps
###########################################################################

# Auth0 CLI tap.
tap "auth0/auth0-cli"

# Azure Bicep tap.
tap "azure/bicep"

# Azure Functions tap.
tap "azure/functions"

# Homebrew Bundle support.
tap "homebrew/bundle"

# Homebrew services support.
tap "homebrew/services"

# [Legacy] Specific .NET SDK versions tap. Enable only for old pinned SDKs.
# tap "isen-ng/dotnet-sdk-versions"


###########################################################################
# 2. Core shell, terminal & workstation utilities
###########################################################################

# Command-line shell and scripting language.
brew "powershell"

# JSON processor.
brew "jq"

# YAML / JSON / XML processor.
brew "yq"

# HTTP client for humans; useful for API troubleshooting.
brew "httpie"

# File download utility.
brew "wget"

# Modern TLS / crypto toolkit.
brew "openssl@3"

# GNU networking utilities: telnet, ftp, rsh, etc.
brew "inetutils"

# Terminal emulator.
cask "iterm2"

# [Optional] Keep Mac awake during long-running work.
cask "caffeine"

# [Optional] Disk usage visualiser.
cask "grandperspective"

# [Optional] Disk space visualiser
# cask "daisydisk"

# Mac App Store command-line interface
brew "mas"

# Apple developer tools required by many build chains.
mas "Xcode", id: 497799835


###########################################################################
# 3. Version control & repository workflow
###########################################################################

# Distributed version control.
brew "git"

# GitHub CLI, useful even if your day job is Azure DevOps.
brew "gh"

# Framework for managing and maintaining multi-language pre-commit hooks.
# brew "pre-commit"

# [Optional] Git large file support. Enable if repositories require LFS.
# brew "git-lfs"

# [Optional] Graphical Git client.
cask "sourcetree"


###########################################################################
# 4. Network troubleshooting & diagnostics
###########################################################################

# Port scanning and network discovery.
brew "nmap"

# [Optional] Tool to obtain certs from Let's Encrypt and auto-enable HTTPS
# brew "certbot"

# Ping + traceroute style diagnostics.
brew "mtr"

# Modern network diagnostic tool inspired by mtr.
brew "trippy"

# Network throughput testing.
brew "iperf3"

# TCP/UDP Swiss-army socket tool.
brew "socat"

# DNS lookup tool with modern output.
brew "doggo"

# Packet capture CLI. macOS ships tcpdump, but Homebrew keeps it current.
brew "tcpdump"

# Network protocol analyzer GUI.
cask "wireshark-app"

# [Optional] Local tunnels for webhook and callback testing.
cask "ngrok"

# [Optional] Web debugging proxy.
# cask "charles"


###########################################################################
# 5. Language runtimes & development foundations
###########################################################################

# Manage multiple Node.js versions
brew "nvm"

# Python version management
brew "pyenv"

# Fast Python package/project manager.
brew "uv"

# Install and run Python CLI apps in isolated environments.
brew "pipx"

# Manage your Java environment
brew "jenv"

# .NET SDK for current .NET development.
cask "dotnet-sdk"

# Corepack manages Yarn / pnpm versions per Node project.
npm "corepack"

# TypeScript compiler
npm "typescript"

# TypeScript execution engine
npm "ts-node"

# Node.js type definitions
npm "@types/node"

# YAML parser / CLI tooling
npm "yaml"

# YAML sorting utility
npm "yaml-sort"

# [Legacy] Use Corepack instead unless a specific legacy global Yarn is required.
# brew "yarn"

# [Legacy] Old project support only.
# brew "python@3.10"

# [Legacy] Old project support only.
# brew "python@3.11"

# [Legacy] Old project support only.
# brew "python-setuptools"

# [Unknown] Core application library for C
brew "glib"

# [Unknown] OpenType text shaping engine
brew "harfbuzz"


###########################################################################
# 6. Azure, Bicep tooling
###########################################################################

# Azure CLI.
brew "azure-cli"

# Bicep CLI.
brew "azure/bicep/bicep"

# Azure Functions Core Tools v4.
brew "azure/functions/azure-functions-core-tools@4"

# [Optional] Azure Storage Explorer GUI.
# cask "microsoft-azure-storage-explorer"

# [PowerShell module, not Homebrew]
# Install inside pwsh when needed:
#   Install-Module -Name PSRule.Rules.Azure -Scope CurrentUser


###########################################################################
# 7. AWS
###########################################################################

# AWS CLI.
brew "awscli"

# AWS CDK managed by npm/nvm. Keep out of Homebrew formulae to avoid split ownership.
npm "aws-cdk"


###########################################################################
# 8. Terraform, Terragrunt & IaC quality
###########################################################################

# Terraform version manager. (*Terraform)
brew "tfenv"

# Terragrunt wrapper for Terraform/OpenTofu workflows. (*Terraform)
brew "terragrunt"

# Terraform linter. (*Terraform)
brew "tflint"

# Terraform module documentation generator. (*Terraform)
brew "terraform-docs"

# IaC static analysis and policy checks. (*Terraform)
brew "checkov"

# Cost estimates for Terraform, Terragrunt and CloudFormation. (*Terraform)
brew "infracost"

# [Optional] OpenTofu CLI. Enable if you actively work with OpenTofu repos. (*Terraform)
# brew "opentofu"

# [Review] tfsec overlaps with Checkov and Trivy. Keep only if repos/pipelines expect it. (*Terraform)
# brew "tfsec"


###########################################################################
# 9. Containers, Kubernetes & supply-chain review
###########################################################################

# Docker Desktop.
cask "docker-desktop"

# Kubernetes CLI.
brew "kubernetes-cli"

# Kubernetes package manager.
brew "helm"

# Terminal UI for Kubernetes.
brew "k9s"

# Container image, filesystem and Git repo vulnerability scanner.
brew "trivy"

# Explore Docker image layers.
brew "dive"

# [Optional] Docker Compose v2 plugin. Docker Desktop usually includes compose.
# brew "docker-compose"


###########################################################################
# 10. AI-assisted code and repository review
###########################################################################

# Fast code search. Useful before handing context to AI tools.
brew "ripgrep"

# Fast file finder.
brew "fd"

# Syntax-aware source viewer.
brew "bat"

# Directory-aware file listing.
brew "eza"

# JSON/YAML/TOML-aware structural search and rewrite.
brew "ast-grep"

# [Optional] Bundle repository content for LLM review.
# npm "repomix"

# [Optional] AI pair-programming CLI. Prefer isolated install with pipx or uv tool.
# Example:
#   uv tool install aider-chat


